{
  "name": "serverless-selfie-sbg",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "frames": "node scripts/build-frames.mjs",
    "cdk": "cdk",
    "cdk:synth": "cdk synth --quiet",
    "cdk:diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "event:cleanup": "node scripts/cleanup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1165.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/lib-dynamodb": "^3.1165.0",
    "@aws-sdk/s3-presigned-post": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "jimp": "^1.6.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1165.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1148.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
