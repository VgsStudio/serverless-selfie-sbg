# Copie para .env (ignorado pelo git) ou exporte no shell antes do `cdk`.
# Nenhum destes valores é segredo, mas também não ficam versionados.

# Obrigatório: ID da hosted zone do Route 53 de vsoller.com.br
HOSTED_ZONE_ID=

# Opcionais (padrões entre parênteses)
# ZONE_NAME=vsoller.com.br
# APP_DOMAIN=selfie.vsoller.com.br
# COGNITO_DOMAIN_PREFIX=vgs-serverless-selfie
# EVENT_ENDS_AT=2026-11-15T02:59:59Z

# Para criar o papel OIDC do GitHub Actions (formato da claim `sub`, sem "repo:")
# GITHUB_REPO_CLAIM=VgsStudio@<ownerId>/serverless-selfie-sbg@<repoId>

# Região/conta vêm do perfil AWS ativo (AWS_PROFILE / aws sso login)
# CDK_DEFAULT_REGION=us-east-1
