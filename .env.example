# Copie para .env (ignorado pelo git). Uso local: `cdk diff` e a criação única do
# papel OIDC. O deploy em si roda no GitHub Actions, que lê os mesmos valores das
# Variables do repositório. Nenhum destes valores é segredo, mas não ficam versionados.

# Obrigatório: ID da hosted zone do Route 53 de vsoller.com.br (variable HOSTED_ZONE_ID)
HOSTED_ZONE_ID=

# Claim do repo para o papel OIDC, formato da claim `sub` sem "repo:"
# (no GitHub: variable REPO_OIDC_CLAIM, porque o prefixo GITHUB_ é reservado)
# GITHUB_REPO_CLAIM=VgsStudio@<ownerId>/serverless-selfie-sbg@<repoId>

# Opcionais (padrões entre parênteses)
# ZONE_NAME=vsoller.com.br
# APP_DOMAIN=serverless-selfie.vsoller.com.br
# COGNITO_DOMAIN_PREFIX=vgs-serverless-selfie
# EVENT_ENDS_AT=2026-11-15T02:59:59Z
